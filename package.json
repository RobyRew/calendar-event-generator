{
  "name": "calendar-event-generator",
  "private": true,
  "version": "2.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "node ./server.mjs",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run && TZ=America/New_York vitest run && TZ=Europe/Bucharest vitest run",
    "test:watch": "vitest",
    "build:static": "BUILD_TARGET=static astro build",
    "typecheck": "astro check && tsc --noEmit",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ./scripts/migrate.mjs",
    "start": "node ./scripts/migrate.mjs && node ./server.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "@astrojs/react": "^7.1.0",
    "@date-fns/tz": "^1.5.0",
    "@logto/node": "^4.0.1",
    "@robyrew/astro-logto": "file:../astro-logto",
    "@robyrew/web-config": "file:../web-config",
    "astro": "^7.4.0",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "timezones-ical-library": "^2.3.2",
    "uuid": "^11.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "ical.js": "^2.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
