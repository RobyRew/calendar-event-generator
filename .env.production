# Committed on purpose. Vite bakes VITE_* into the shipped bundle, so these are
# public identifiers, not secrets. They live here rather than in Dokploy's env UI
# because the previous runtime-injection approach depended on env vars nobody set
# — the live page carried no analytics tag at all from deployment until 2026-09-04.
#
# data-domains pins reporting to this hostname, so a fork deployed elsewhere
# reports nothing.
VITE_UMAMI_SCRIPT_URL=https://stats.cosmincalin.es/script.js
VITE_UMAMI_WEBSITE_ID=e56b32b6-d80c-4dd7-a592-5bc94a8b02e0
VITE_UMAMI_DOMAINS=calendar.robyrew.com
